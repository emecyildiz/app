# Store the real file as /etc/emecworks/ratemet.env on the VPS.
# Generate long random values; never commit the real file.
RATEMET_POSTGRES_PASSWORD=replace-with-a-long-random-password
RATEMET_IP_HASH_SECRET=replace-with-at-least-32-random-bytes

# Use either a TMDB v4 token or a v3 API key. The v4 token is preferred.
RATEMET_TMDB_V4_TOKEN=
RATEMET_TMDB_API_KEY=
RATEMET_TMDB_LANGUAGE=en-US

RATEMET_SESSION_TTL_DAYS=14
RATEMET_AUTH_REQUIRE_EMAIL_VERIFICATION=true
RATEMET_RESEND_API_KEY=
RATEMET_EMAIL_FROM="Ratemet <accounts@notify.emecworks.com>"
RATEMET_N8N_WEBHOOK_URL=

# Localhost-only diagnostic endpoint on the VPS.
RATEMET_DIAGNOSTIC_PORT=8091

# Legacy combined template retained for compatibility.
# Prefer `.env.example` for the frontend and `backend/.env.example` for the API.

# Frontend
VITE_API_URL=http://localhost:8080
VITE_APP_NAME=Ratemet
VITE_APP_LOGO_URL=/brand/ratemet-logo.png
VITE_HTTP_TIMEOUT_MS=10000

# Backend
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://ratemet:change-me@localhost:5434/ratemet
DATABASE_SSL=false
DATABASE_POOL_MAX=10
TMDB_V4_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1
SESSION_COOKIE_NAME=ratemet_session
SESSION_TTL_DAYS=14
AUTH_REQUIRE_EMAIL_VERIFICATION=true
IP_HASH_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
EMAIL_FROM=Ratemet <accounts@notify.emecworks.com>

/* Modern Sidebar Styles */
.sidebar {
    position: fixed;
    top: 0;
    left: -280px; /* Hidden by default */
    height: 100vh;
    width: 280px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    backdrop-filter: blur(10px);
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow-y: auto;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar.open {
    left: 0;
}

/* Overlay background when sidebar is open */
.sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
}

.sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
}

/* Sidebar Toggle Button */
.sidebar-toggle {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 1100;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    border-radius: 12px;
    color: white;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
}

.sidebar-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
}

.sidebar-toggle.active {
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
    transform: rotate(90deg);
}

/* Logo Section */
.logo {
    font-weight: bold;
    font-size: 24px;
    color: white;
    text-align: center;
    padding: 30px 20px 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

/* Profile Section */
.profil-section {
    padding: 20px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 20px;
}

.profile-image {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
    margin: 0 auto 15px;
    display: block;
    object-fit: cover;
}

.profile-image:hover {
    transform: scale(1.05);
    border-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
}

.profile-name {
    color: white;
    font-size: 18px;
    font-weight: bold;
    margin: 10px 0 5px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.eposta {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    margin: 0;
}

/* Menu Items */
.item {
    cursor: pointer;
    padding: 15px 25px;
    font-size: 16px;
    font-weight: 500;
    color: white;
    margin: 5px 15px;
    border-radius: 12px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 12px;
}

.item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.item:hover::before {
    left: 100%;
}

.item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(5px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.item:active {
    transform: translateX(5px) scale(0.98);
}

/* Logout Section */
.space {
    flex: 1;
}

.out {
    margin: 20px 15px;
}

.out .item {
    background: rgba(255, 107, 107, 0.2);
    border: 1px solid rgba(255, 107, 107, 0.3);
}

.out .item:hover {
    background: rgba(255, 107, 107, 0.3);
    border-color: rgba(255, 107, 107, 0.5);
}

/* Content Area */
.content {
    padding: 20px;
    margin-top: 70px;
    transition: none; /* Remove margin transition since we're overlaying */
    min-height: calc(100vh - 70px);
}

/* Responsive Design */
@media (max-width: 768px) {
    .sidebar {
        width: 100%;
        left: -100%;
    }
    
    .sidebar-toggle {
        top: 15px;
        left: 15px;
        width: 45px;
        height: 45px;
        font-size: 18px;
    }
}

/* Scrollbar Styling for Sidebar */
.sidebar::-webkit-scrollbar {
    width: 6px;
}

.sidebar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
}

.sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
}

.sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
}

/* Animation for menu items */
.item {
    animation: slideInLeft 0.3s ease forwards;
    opacity: 0;
    transform: translateX(-20px);
}

.sidebar.open .item:nth-child(1) { animation-delay: 0.1s; }
.sidebar.open .item:nth-child(2) { animation-delay: 0.2s; }
.sidebar.open .item:nth-child(3) { animation-delay: 0.3s; }
.sidebar.open .item:nth-child(4) { animation-delay: 0.4s; }
.sidebar.open .item:nth-child(5) { animation-delay: 0.5s; }

@keyframes slideInLeft {
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* Profil ana içerik ve kartı */
.profile-main-content {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 60vh;
    padding: 3rem 1rem;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
}
.profile-card {
    display: flex;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    padding: 2.5rem 2.5rem 2rem 2rem;
    gap: 2.5rem;
    align-items: center;
    min-width: 340px;
    max-width: 600px;
    width: 100%;
}
.profile-left {
    flex-shrink: 0;
}
.profile-image-large {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #e0e7ef;
    box-shadow: 0 2px 12px rgba(59,130,246,0.08);
}
.profile-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
}
.profile-username {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.2rem;
}
.profile-fullname {
    font-size: 1.1rem;
    color: #64748b;
    margin-bottom: 0.7rem;
}
.profile-stats {
    display: flex;
    gap: 2.5rem;
    margin-top: 0.7rem;
}
.profile-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.stat-number {
    font-size: 1.5rem;
    font-weight: 600;
    color: #3b82f6;
}
.stat-label {
    font-size: 0.95rem;
    color: #64748b;
}
@media (max-width: 700px) {
    .profile-card {
        flex-direction: column;
        align-items: center;
        gap: 1.2rem;
        padding: 1.5rem 1rem;
    }
    .profile-main-content {
        padding: 1.5rem 0.2rem;
    }
    .profile-stats {
        gap: 1.2rem;
    }
}

/* Favori filmler ve arkadaşlar bölümü */
.profile-section-title {
    font-size: 1.08rem;
    font-weight: 600;
    color: #1e293b;
    margin-top: 1.2rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.profile-favorites-list {
    display: flex;
    gap: 1.2rem;
    margin-bottom: 0.5rem;
}
.favorite-movie {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    background: #f1f5f9;
    border-radius: 10px;
    padding: 0.5rem 0.7rem;
    min-width: 70px;
    box-shadow: 0 1px 4px rgba(59,130,246,0.06);
}
.favorite-movie img {
    width: 48px;
    height: 68px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 0.2rem;
}
.favorite-movie span {
    font-size: 0.95rem;
    color: #334155;
    text-align: center;
}
.profile-friends-list {
    display: flex;
    gap: 0.7rem;
    margin-top: 0.2rem;
}
.friend-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #e0e7ef;
    background: #fff;
    box-shadow: 0 1px 4px rgba(59,130,246,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
}
.friend-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}
.profile-private-label {
    background: #fbbf24;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 8px;
    padding: 0.1rem 0.6rem;
    margin-left: 0.3rem;
    letter-spacing: 0.5px;
    box-shadow: 0 1px 4px rgba(251,191,36,0.10);
}
@media (max-width: 700px) {
    .profile-favorites-list {
        gap: 0.5rem;
    }
    .profile-section-title {
        margin-top: 0.7rem;
    }
}

/* Sosyal bağlantılar bölümü */
.profile-social-section {
    margin-top: 1.2rem;
}
.profile-social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
    margin-top: 0.2rem;
}
.social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
    color: #64748b;
    background: #f1f5f9;
    border-radius: 8px;
    padding: 0.35rem 0.9rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    font-weight: 500;
}
.social-link i {
    font-size: 1.2rem;
}
.social-link.instagram {
    color: #e1306c;
}
.social-link.instagram:hover {
    background: #e1306c;
    color: #fff;
}
.social-link.facebook {
    color: #1877f3;
}
.social-link.facebook:hover {
    background: #1877f3;
    color: #fff;
}
.social-link.gmail {
    color: #ea4335;
}
.social-link.gmail:hover {
    background: #ea4335;
    color: #fff;
}
@media (max-width: 700px) {
    .profile-social-list {
        gap: 0.4rem 0.7rem;
    }
    .social-link {
        font-size: 0.97rem;
        padding: 0.28rem 0.6rem;
    }
}

/* Hakkımda kutusu */
.profile-about-section {
    margin-top: 1.2rem;
}
.profile-about-box {
    background: #f8fafc;
    border-radius: 10px;
    padding: 1rem 1.2rem;
    color: #334155;
    font-size: 1.05rem;
    line-height: 1.6;
    box-shadow: 0 1px 4px rgba(59,130,246,0.06);
    min-height: 48px;
    margin-bottom: 0.2rem;
    word-break: break-word;
}
@media (max-width: 700px) {
    .profile-about-box {
        padding: 0.7rem 0.6rem;
        font-size: 0.97rem;
    }
}

/* Rozetler bölümü */
.profile-badges-section {
    margin-top: 1.2rem;
}
.profile-badges-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem 1.7rem;
    margin-top: 0.3rem;
}
.profile-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #f1f5f9;
    border-radius: 12px;
    padding: 0.7rem 1.1rem 0.5rem 1.1rem;
    min-width: 90px;
    box-shadow: 0 1px 4px rgba(59,130,246,0.06);
    transition: transform 0.15s;
}
.profile-badge:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 4px 16px rgba(59,130,246,0.13);
}
.profile-badge i {
    font-size: 2rem;
    margin-bottom: 0.3rem;
    color: #fbbf24;
    text-shadow: 0 1px 4px rgba(251,191,36,0.10);
}
.profile-badge .fa-comment-dots {
    color: #3b82f6;
    text-shadow: 0 1px 4px rgba(59,130,246,0.10);
}
.profile-badge .fa-star {
    color: #f59e42;
    text-shadow: 0 1px 4px rgba(245,158,66,0.10);
}
.badge-title {
    font-size: 1.01rem;
    font-weight: 600;
    color: #334155;
    text-align: center;
    margin-top: 0.1rem;
}
@media (max-width: 700px) {
    .profile-badges-list {
        gap: 0.5rem 0.7rem;
    }
    .profile-badge {
        min-width: 70px;
        padding: 0.5rem 0.5rem 0.4rem 0.5rem;
    }
    .profile-badge i {
        font-size: 1.3rem;
    }
    .badge-title {
        font-size: 0.93rem;
    }
}

/* Kapak resmi ve profil header LinkedIn tarzı (sadece görsel ve header) */
.profile-cover-wrapper {
    position: relative;
    width: 100vw;
    height: 220px;
    background: #e0e7ef;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}
.profile-cover-image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100vw;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    background: #e0e7ef;
}
.profile-photo-header-row {
    position: absolute;
    left: 50%;
    bottom: -55px;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-end;
    gap: 2.2rem;
    z-index: 5;
    width: auto;
    background: none;
}
.profile-image-huge {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #fff;
    box-shadow: 0 2px 12px rgba(59,130,246,0.10);
    background: #fff;
    z-index: 6;
    position: static;
}
.profile-header-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-left: 0;
    align-items: flex-start;
}
.profile-username {
    font-size: 1.6rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.1rem;
}
.profile-fullname {
    font-size: 1.13rem;
    color: #64748b;
    margin-bottom: 0.2rem;
}
.profile-join-date {
    font-size: 0.98rem;
    color: #94a3b8;
    margin-top: 0.2rem;
}
.profile-fullpage-wrapper {
    position: relative;
    min-height: calc(100vh - 180px);
    width: 100vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background: transparent;
    padding: 0;
    margin-top: 0;
    z-index: 3;
}
/* Profil kartı ve içeriği tam ekran */
.profile-fullpage-card {
    margin-top: 70px;
    box-shadow: none;
    border-radius: 0;
    background: #fff;
    max-width: 100vw;
    width: 100vw;
    min-height: 100vh;
    z-index: 4;
    position: relative;
    padding: 0;
}
.profile-fullpage-body {
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
    background: #fff;
    padding: 0;
}
/* Profil header ikiye bölünmüş, modern ve geniş */
.profile-header-flex {
    position: absolute;
    left: 50%;
    bottom: -55px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 90vw;
    max-width: 1200px;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 6px 32px rgba(59,130,246,0.10);
    padding: 2.2rem 2.5rem 2.2rem 2.5rem;
    gap: 3.5rem;
    z-index: 5;
}
.profile-header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    min-width: 0;
    flex: 2;
}
.profile-header-maininfo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
}
.profile-header-stats {
    display: flex;
    gap: 2.5rem;
    margin: 1.2rem 0 0.7rem 0;
}
.profile-header-favorites {
    margin-top: 0.5rem;
}
.profile-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 220px;
    flex: 1;
    gap: 1.2rem;
}
.profile-badges-section {
    margin-top: 0;
}
.profile-image-huge {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #fff;
    box-shadow: 0 2px 12px rgba(59,130,246,0.10);
    background: #fff;
    z-index: 6;
    position: static;
    margin-bottom: 0.5rem;
}
@media (max-width: 1100px) {
    .profile-header-flex {
        width: 98vw;
        padding: 1.2rem 0.5rem 1.2rem 0.5rem;
        gap: 1.2rem;
    }
}
@media (max-width: 900px) {
    .profile-cover-wrapper {
        height: 120px;
    }
    .profile-header-flex {
        flex-direction: column;
        align-items: center;
        width: 99vw;
        padding: 1.2rem 0.2rem 1.2rem 0.2rem;
        gap: 1.2rem;
    }
    .profile-header-left, .profile-header-right {
        align-items: center;
        min-width: 0;
        width: 100%;
    }
    .profile-header-right {
        align-items: center;
        margin-top: 1.2rem;
    }
    .profile-image-huge {
        width: 70px;
        height: 70px;
    }
}
@media (max-width: 600px) {
    .profile-cover-wrapper {
        height: 60px;
    }
    .profile-header-flex {
        bottom: -22px;
        gap: 0.5rem;
        padding: 0.5rem 0.1rem 0.5rem 0.1rem;
        border-radius: 8px;
    }
    .profile-image-huge {
        width: 44px;
        height: 44px;
    }
}

/* Profil ana kart üst satırı yatayda geniş ve modern */
.profile-main-toprow {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    gap: 3.5rem;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
}
.profile-stats-section, .profile-favorites-section {
    flex: 1;
    min-width: 220px;
}
.profile-stats-section {
    margin-right: 2.5rem;
}
.profile-favorites-section {
    margin-left: 2.5rem;
}
@media (max-width: 900px) {
    .profile-main-toprow {
        flex-direction: column;
        align-items: center;
        gap: 1.2rem;
        margin-top: 1.2rem;
        margin-bottom: 1.2rem;
    }
    .profile-stats-section, .profile-favorites-section {
        margin: 0;
        width: 100%;
    }
}
